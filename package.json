{
	"name": "axxa-inspector",
	"version": "0.1.0",
	"description": "Visual DOM & CSS DevTools for Obsidian plugin and theme creators.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package": "npm run build && node scripts/copy-output.mjs",
		"prepare": "git config core.hooksPath .githooks || true",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src --ext .ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"devtools",
		"inspector",
		"css",
		"dom",
		"theme-development"
	],
	"author": "AXXA Studio Lab",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^8.56.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0",
		"vitest": "^1.4.0"
	}
}
